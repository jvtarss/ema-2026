#!/bin/bash
#PBS -N ema_mirdeep2_v3
#PBS -l select=1:ncpus=128:mem=256gb
#PBS -l walltime=96:00:00
#PBS -q par128
#PBS -j oe
#PBS -o ema_mirdeep2_v3.log

source ~/miniconda3/etc/profile.d/conda.sh
conda activate bioinfo
export PATH="${HOME}/miniconda3/envs/bioinfo/bin:${PATH}"
export LD_LIBRARY_PATH="${HOME}/miniconda3/envs/bioinfo/lib:${LD_LIBRARY_PATH}"
cd $PBS_O_WORKDIR

genome="${HOME}/references/Egrandis_297_v2.0.fa"
index="${HOME}/references/Egrandis_v2"
reads_dir="${HOME}/mirnaseq-euca/trimmed"

# Referencias de HOMOLOGIA usadas APENAS na etapa de descoberta (identificacao
# de known via miRDeep2.pl). NAO sao usadas para quantificacao/DE — a
# referencia de quantificacao e construida mais abaixo, a partir do catalogo
# curado final (mirna_core.csv / mirna_precursors.csv), para garantir que os
# numeros de expressao/DE correspondam exatamente as 91 entradas publicadas
# no EMA. Origem: mature/hairpin subset PmiREN para E. grandis — declarar
# explicitamente esta fonte no Methods 2.2 do manuscrito.
ref_mature="${HOME}/euca-mirna/reference_mature_final.fa"
ref_hairpin="${HOME}/mirnaseq-euca/miRNA_stem-loop_seq-euca-pmiren.txt"

outdir="${PBS_O_WORKDIR}/ema-final-v3"
mkdir -p "$outdir"
cd "$outdir"

# ============================================================
# LIMPEZA: nenhum artefato de LEVY-2014 deve existir nesta pasta.
# LEVY-2014 nao faz parte do EMA e nao deve ser referenciado em
# nenhuma etapa (descoberta, quantificacao ou curadoria).
# ============================================================
rm -rf discovery_LEVY-2014 mirna_results_*LEVY-2014 pdfs_*LEVY-2014 \
       result_*LEVY-2014.* expression_*LEVY-2014.* error_*LEVY-2014.log \
       dir_prepare_signature* 2>/dev/null
find "$reads_dir" -iname "*LEVY*" -exec echo "AVISO: arquivo LEVY encontrado, nao sera usado: {}" \;

# ============================================================
# ETAPA 1 — preparo das referencias de HOMOLOGIA (uso exclusivo
# na descoberta, nunca na quantificacao final)
# ============================================================
awk '/^>/{printf("\n%s\n",$1);next}{printf("%s",$1)}END{printf("\n")}' $ref_mature \
    | sed '/^$/d;s/\r//g' > ref_linear.fa
grep -A1 "Egr-" ref_linear.fa | grep -v "^--$" > mature_egr.fa
grep -v "Egr-" ref_linear.fa | grep -A1 "^>" | grep -v "^--$" > mature_other.fa
awk '/^>/{print $1;next}{print $1}' $ref_hairpin | sed 's/\r//g' > hairpin_egr.fa

# ============================================================
# ETAPA 2 — descoberta de novo por estudo (independente, conforme
# Methods 2.4). Amostras: 1 replicata representativa por combinacao
# de tecido/genotipo/condicao para QIN-2021 e TOLENTINO-2022, e
# AMBAS as amostras do LIN-2018 (folha + caule — corrigido; a
# versao anterior usava so a folha, SRR5433935).
# ============================================================
declare -A STUDY_SAMPLES=(
    [QIN-2021]="SRR11749594_QIN-2021_callus_GL9-rep1_trimmed.fastq.gz
SRR11749597_QIN-2021_stem_GL9-rep1_trimmed.fastq.gz
SRR11749600_QIN-2021_callus_DH201-2-rep1_trimmed.fastq.gz
SRR11749605_QIN-2021_stem_DH201-2-rep1_trimmed.fastq.gz"
    [TOLENTINO-2022]="SRR14138141_TOLENTINO_2022_stem_tension_wood_rep1_trimmed.fastq.gz
SRR14138142_TOLENTINO_2022_stem_opposite_wood_rep1_trimmed.fastq.gz
SRR14138143_TOLENTINO_2022_stem_unbent_control_rep1_trimmed.fastq.gz"
    [LIN-2018]="SRR5433935_LIN-2018_leaves-stems_rep1_trimmed.fastq.gz
SRR5433936_LIN-2018_leaves-stems_rep2_1_trimmed.fastq.gz"
)

for study in QIN-2021 TOLENTINO-2022 LIN-2018; do
    study_dir="discovery_${study}"
    mkdir -p "$study_dir/tmp"
    config="$study_dir/config.txt"
    > "$config"
    tag_n=1
    while IFS= read -r gz; do
        [[ -z "$gz" ]] && continue
        if [[ -f "${reads_dir}/${gz}" ]]; then
            base=$(basename "$gz" .gz)
            zcat "${reads_dir}/${gz}" > "$study_dir/tmp/$base"
            printf "%s\t%s\n" "$study_dir/tmp/$base" "$(printf 'd%02d' $tag_n)" >> "$config"
            ((tag_n++))
        else
            echo "AVISO: arquivo esperado nao encontrado: ${gz}" >&2
        fi
    done <<< "${STUDY_SAMPLES[$study]}"

    mapper.pl "$config" -d -e -h -i -j -l 18 -m \
        -p "$index" \
        -s "$study_dir/reads_collapsed.fa" \
        -t "$study_dir/reads_vs_genome.arf" \
        -v -o 128

    rm -rf "$study_dir/tmp"

    # -P removido: mature_egr.fa nao usa convencao miRBase v18 (-5p/-3p)
    miRDeep2.pl \
        "$study_dir/reads_collapsed.fa" \
        "$genome" \
        "$study_dir/reads_vs_genome.arf" \
        mature_egr.fa mature_other.fa hairpin_egr.fa \
        -z "${study}" \
        2> "$study_dir/mirdeep2.log"

    run_d=$(ls -td mirdeep_runs/run_*${study}/ 2>/dev/null | head -1)
    if [[ -n "$run_d" ]]; then
        result_csv=$(ls "${run_d}"../result_*${study}*.csv 2>/dev/null | head -1)
        [[ -n "$result_csv" ]] && cp "$result_csv" "${study_dir}/result_${study}.csv"
    else
        echo "ERRO: nenhum diretorio de execucao encontrado para ${study}" >&2
        exit 1
    fi
done

# ============================================================
# ETAPA 3 — curadoria por uniao (01.py). Gera mirna_core.csv,
# mirna_precursors.csv, mirna_discovery_metrics.csv,
# mirna_discovery_evidence.csv, id_to_acc.tsv — o catalogo final
# de 91 miRNAs que sera publicado no EMA.
# ============================================================
cp ../01.py .
python3 01.py
if [[ ! -s mirna_core.csv ]]; then
    echo "ERRO: 01.py nao gerou mirna_core.csv" >&2
    exit 1
fi
n_core=$(($(wc -l < mirna_core.csv) - 1))
echo "Catalogo curado final: ${n_core} miRNAs"

# ============================================================
# ETAPA 4 — construcao da referencia de QUANTIFICACAO a partir do
# catalogo curado final (NAO do arquivo externo). Isso garante que
# todo miRNA no mirna_deg.csv corresponde exatamente a um accession
# existente em mirna_core.csv — resolve o problema de missing_ids.
# ============================================================
python3 - << 'PYEOF'
import csv

with open("mirna_core.csv") as f:
    core = list(csv.DictReader(f))
with open("mirna_precursors.csv") as f:
    prec_by_acc = {}
    for row in csv.DictReader(f):
        prec_by_acc.setdefault(row["mirna_accession"], row)

with open("quant_mature.fa", "w") as fm, open("quant_hairpin.fa", "w") as fh:
    missing_prec = []
    for row in core:
        acc = row["accession"]
        mid = row["mirna_id"]
        mat = row["mature_sequence"].strip().upper().replace("T", "U")
        fm.write(f">{mid}\n{mat}\n")
        prec = prec_by_acc.get(acc)
        if prec and prec.get("premir_sequence_stem_loop"):
            pseq = prec["premir_sequence_stem_loop"].strip().upper().replace("T", "U")
            fh.write(f">{mid}\n{pseq}\n")
        else:
            missing_prec.append(mid)
    if missing_prec:
        print(f"AVISO: {len(missing_prec)} miRNAs sem precursor: {missing_prec}")

print(f"quant_mature.fa e quant_hairpin.fa gerados a partir do catalogo curado ({len(core)} entradas)")
PYEOF

n_mat=$(grep -c '^>' quant_mature.fa)
n_hp=$(grep -c '^>' quant_hairpin.fa)
echo "quant_mature.fa: ${n_mat} sequencias | quant_hairpin.fa: ${n_hp} sequencias"
if [[ "$n_mat" -ne "$n_core" ]]; then
    echo "ERRO: numero de maduras (${n_mat}) difere do catalogo curado (${n_core})" >&2
    exit 1
fi

# ============================================================
# ETAPA 5 — colapso de reads para TODAS as 20 amostras (quantificacao)
# ============================================================
mkdir -p quant_tmp
> config_quant.txt
> sample_mapping.txt
tag_n=1
for gz in "$reads_dir"/*.fastq.gz; do
    [[ -f "$gz" ]] || continue
    base=$(basename "$gz")
    [[ "$base" == *LEVY* ]] && { echo "Ignorando LEVY: $base"; continue; }
    base_noext=$(basename "$gz" .gz)
    zcat "$gz" > "quant_tmp/$base_noext"
    tag=$(printf 's%02d' $tag_n)
    printf "%s\t%s\n" "quant_tmp/$base_noext" "$tag" >> config_quant.txt
    printf "%s\t%s\n" "$tag" "${base_noext%_trimmed}" >> sample_mapping.txt
    ((tag_n++))
done
n_samples=$((tag_n - 1))
echo "Amostras incluidas na quantificacao: ${n_samples}"
if [[ "$n_samples" -ne 20 ]]; then
    echo "AVISO: esperado 20 amostras (3 estudos, sem LEVY), obtido ${n_samples}" >&2
fi

mapper.pl config_quant.txt -d -e -h -i -j -l 18 -m \
    -s reads_collapsed_all.fa -v -o 128
rm -rf quant_tmp

# ============================================================
# ETAPA 6 — quantificacao contra o catalogo final curado
# ============================================================
quantifier.pl \
    -p quant_hairpin.fa \
    -m quant_mature.fa \
    -r reads_collapsed_all.fa \
    -y quant_final

awk 'BEGIN{FS=OFS="\t"}
     NR==FNR{map[$1]=$2;next}
     FNR==1{for(i=4;i<=NF;i++) if($i in map) $i=map[$i]; print; next}
     {print}' \
    sample_mapping.txt \
    miRNAs_expressed_all_samples_quant_final.csv \
    > matriz_raw_counts_v3.tsv

n_matrix_mirnas=$(($(wc -l < matriz_raw_counts_v3.tsv) - 1))
echo "miRNAs na matriz de contagem final: ${n_matrix_mirnas}"
if [[ "$n_matrix_mirnas" -ne "$n_core" ]]; then
    echo "ERRO: matriz de contagem (${n_matrix_mirnas}) nao bate com o catalogo curado (${n_core})" >&2
    exit 1
fi

# ============================================================
# ETAPA 7 — CPM/TMM e deteccao por estudo
# (mesmo design estatistico ja usado; so a matriz de entrada muda)
# ============================================================
Rscript - << 'REOF'
library(edgeR)

mat <- read.table("matriz_raw_counts_v3.tsv", header=TRUE, sep="\t",
                  row.names=1, check.names=FALSE)
count_cols <- grep("^s[0-9]", colnames(mat), value=TRUE)
counts     <- round(as.matrix(mat[, count_cols]))

# total_mapped_reads: manter em unico local (samples.csv) para evitar
# divergencia entre scripts. Valores abaixo devem ser conferidos contra
# samples.csv apos a correcao do metadado LIN (SRR5433935=leaves,
# SRR5433936=stem) — ja refletidos aqui (s19/s20).
total_mapped <- c(
    s01=4924803, s02=7851908, s03=7615187, s04=5595785,
    s05=3922069, s06=4374390, s07=3337457, s08=7139036,
    s09=5263470, s10=2999629, s11=6484107, s12=7886357,
    s13=2322472, s14=2320551, s15=3142756,
    s16=3871442, s17=2011494, s18=4555273,
    s19=795373,  s20=1384187
)

shared_cols <- intersect(count_cols, names(total_mapped))
counts      <- counts[, shared_cols, drop=FALSE]
lib_sizes   <- total_mapped[shared_cols]

cpm_mat <- sweep(counts, 2, lib_sizes / 1e6, FUN="/")
cpm_mat[is.nan(cpm_mat)] <- 0

y    <- DGEList(counts=counts, lib.size=lib_sizes)
y    <- calcNormFactors(y, method="TMM")
tmm  <- cpm(y, normalized.lib.sizes=TRUE)

write.table(cbind(miRNA=rownames(cpm_mat), round(cpm_mat, 4)),
            "matriz_cpm_v3.tsv", sep="\t", quote=FALSE, row.names=FALSE)
write.table(cbind(miRNA=rownames(tmm), round(tmm, 4)),
            "matriz_tmm_v3.tsv", sep="\t", quote=FALSE, row.names=FALSE)

detection <- apply(counts[, shared_cols, drop=FALSE], 1, function(x) {
    studies <- list(
        QIN       = paste0("s", sprintf("%02d", 1:12)),
        TOLENTINO = paste0("s", sprintf("%02d", 13:18)),
        LIN       = paste0("s", sprintf("%02d", 19:20))
    )
    sapply(studies, function(tags) {
        t <- intersect(tags, shared_cols)
        as.integer(any(x[t] > 0))
    })
})
detection_df <- as.data.frame(t(detection))
detection_df$n_studies   <- rowSums(detection_df)
detection_df$detected_in <- apply(detection_df[, 1:3], 1, function(r)
    paste(names(r)[r == 1], collapse=";"))
detection_df <- cbind(miRNA=rownames(detection_df), detection_df)
write.table(detection_df, "study_detection_v3.tsv",
            sep="\t", quote=FALSE, row.names=FALSE)

cat("CPM e TMM gerados (referencia = catalogo curado final).\n")
cat(sprintf("miRNAs detectados em >= 2 estudos: %d\n",
    sum(detection_df$n_studies >= 2)))
cat(sprintf("miRNAs detectados em 1 estudo: %d\n",
    sum(detection_df$n_studies == 1)))
cat(sprintf("Total de miRNAs na matriz: %d (esperado: %d)\n",
    nrow(detection_df), nrow(counts)))
REOF

echo "PIPELINE V3 CONCLUIDO"
echo "Proximo passo: re-rodar DESeq2 (mesmo desenho estatistico ja validado)"
echo "sobre matriz_raw_counts_v3.tsv, e re-rodar 04.py (agora com match 1:1"
echo "garantido por construcao, sem necessidade de correspondencia por string"
echo "ou por sequencia)."
