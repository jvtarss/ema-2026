#!/bin/bash
#PBS -N ema_genome_map_all20
#PBS -l select=1:ncpus=128:mem=256gb
#PBS -l walltime=24:00:00
#PBS -q par128
#PBS -j oe
#PBS -o ema_genome_map_all20.log

source ~/miniconda3/etc/profile.d/conda.sh
conda activate bioinfo
export PATH="${HOME}/miniconda3/envs/bioinfo/bin:${PATH}"
export LD_LIBRARY_PATH="${HOME}/miniconda3/envs/bioinfo/lib:${LD_LIBRARY_PATH}"

cd "${HOME}/mirnaseq-euca/ema-final-v3"
index="${HOME}/references/Egrandis_v2"

# reads_collapsed_all.fa ja existe (gerado na etapa de quantificacao).
# Falta apenas o mapeamento desse arquivo colapsado contra o genoma,
# para obter total_mapped_reads correto e nao-circular por amostra.
mapper.pl reads_collapsed_all.fa -c \
    -p "$index" \
    -t reads_vs_genome_all.arf \
    -v -o 128

echo "Mapeamento genomico concluido para as 20 amostras (via reads_collapsed_all.fa)"
